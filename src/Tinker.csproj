    <!-- Compile optional integration into normal releases. Runtime calls are isolated
         behind a non-inlined bridge, so Rain Meadow is not required to play offline. -->
    <EnableRainMeadow Condition="'$(EnableRainMeadow)' == ''">true</EnableRainMeadow>
    <DefineConstants Condition="'$(EnableRainMeadow)' == 'true'">$(DefineConstants);RAINMEADOW</DefineConstants>
</PropertyGroup>
    
